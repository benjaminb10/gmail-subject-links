{
  "manifest_version": 3,
  "name": "Gmail Subject Links",
  "version": "1.0.0",
  "description": "Makes URLs in Gmail subject lines clickable.",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/benjaminb10/gmail-subject-links"
}
